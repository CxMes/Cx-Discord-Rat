@client.command(name="macadres")
async def get_mac_address(ctx):
  """Bilgisayarın ağ kartlarının fiziksel MAC adreslerini listeler."""
  try:
    output = subprocess.check_output(
        "getmac /fo table /nh", shell=True, encoding="latin-1"
    )
    if not output.strip():
      import uuid

      mac = ":".join(
          [
              "{:02x}".format((uuid.getnode() >> ele) & 0xFF)
              for ele in range(0, 8 * 6, 8)
          ][::-1]
      )
      output = f"Ana MAC (UUID): {mac}"

    if len(output) > 1900:
      output = output[:1900] + "\n..."
    await ctx.send(f"🌐 **MAC Adresleri ve Ağ Arayüzleri:**\n```text\n{output}\n```")
  except Exception as e:
