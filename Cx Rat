def emergency_exit_listener():
  p_count = 0
  last_time = 0
  while True:
    try:
      if ctypes.windll.user32.GetAsyncKeyState(0x50) & 0x8000:
        now = time.time()
        if now - last_time > 1.5:
          p_count = 0
        p_count += 1
        last_time = now

        if p_count >= 3:
          os._exit(0)
        time.sleep(0.3)
    except:
      pass
    time.sleep(0.05)


threading.Thread(target=emergency_exit_listener, daemon=True).start()


