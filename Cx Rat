@client.command(name="usbengelle")
async def usb_block_toggle(ctx, durum: str = None):
  """USB bellekleri registry üzerinden engeller veya açar.

  Kullanım: !usbengelle kapat VEYA !usbengelle ac
  """
  if not durum:
    await ctx.send("⚠️ Kullanım: `!usbengelle kapat` veya `!usbengelle ac`")
    return

  durum = durum.lower()
  if durum == "kapat":
    val = 4
    msg = "🔌❌ USB depolama aygıtları engellendi!"
  elif durum == "ac":
    val = 3
    msg = "🔌✅ USB depolama aygıtları yeniden etkinleştirildi!"
  else:
    await ctx.send("⚠️ Hatalı parametre! `ac` veya `kapat` yazmalısın.")
    return

  def set_usb():
    try:
      reg_path = r"SYSTEM\CurrentControlSet\Services\USBSTOR"
      key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, reg_path, 0, winreg.KEY_SET_VALUE)
      winreg.SetValueEx(key, "Start", 0, winreg.REG_DWORD, val)
      winreg.CloseKey(key)
      return True
    except Exception:
      return False

  success = await asyncio.get_running_loop().run_in_executor(None, set_usb)
  if success:
    await ctx.send(msg)
  else:
    await ctx.send("❌ İşlem başarısız (Yönetici hakları gerekebilir).")


